{
  "version": 2,
  "framework": null,
  "outputDirectory": "laravel-app/public",
  "functions": {
    "laravel-app/api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/laravel-app/public/build/$1"
    },
    {
      "src": "/data/(.*)",
      "dest": "/laravel-app/public/data/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/laravel-app/public/favicon.ico"
    },
    {
      "src": "/favicon.svg",
      "dest": "/laravel-app/public/favicon.svg"
    },
    {
      "src": "/robots.txt",
      "dest": "/laravel-app/public/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/laravel-app/api/index.php"
    }
  ],
  "env": {
    "FIREBASE_DRIVER": "firestore",
    "FIREBASE_PROJECT_ID": "@firebase_project_id",
    "FIREBASE_DATABASE_ID": "@firebase_database_id",
    "FIREBASE_CREDENTIALS_BASE64": "@firebase_credentials_base64",
    "SESSION_DRIVER": "cookie",
    "CACHE_STORE": "file",
    "QUEUE_CONNECTION": "sync"
  }
}
