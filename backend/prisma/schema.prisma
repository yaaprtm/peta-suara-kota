// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  WARGA
  PETUGAS
  ADMIN
}

enum ReportStatus {
  BARU
  DIPROSES
  SELESAI
  DITOLAK
}

enum ReportCategory {
  INFRASTRUKTUR
  KEBERSIHAN
  KEAMANAN
  BANJIR
  LAINNYA
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  phone        String?
  role         UserRole @default(WARGA)
  avatar       String?
  kelurahanId  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  kelurahan    Kelurahan? @relation(fields: [kelurahanId], references: [id])
  reports      Report[]
  statusLogs   StatusLog[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Kelurahan {
  id           String  @id @default(uuid())
  name         String
  kecamatan    String
  kota         String
  // Geometry stored as PostGIS polygon - accessed via raw SQL
  // geometry  Unsupported("geometry(Polygon, 4326)")?
  centroidLat  Float?
  centroidLng  Float?
  createdAt    DateTime @default(now())

  users        User[]
  reports      Report[]

  @@map("kelurahans")
}

model Category {
  id          String         @id @default(uuid())
  name        String         @unique
  type        ReportCategory @unique
  icon        String         // emoji or icon name
  description String?
  baseScore   Int            @default(30) // base urgency score for this category

  reports     Report[]

  @@map("categories")
}

model Report {
  id              String         @id @default(uuid())
  title           String
  description     String
  category        ReportCategory
  status          ReportStatus   @default(BARU)
  
  // Location
  latitude        Float
  longitude       Float
  address         String?
  kelurahanId     String?
  
  // Urgency scoring
  skorUrgensi     Int            @default(0)  // 0-100
  urgensiKeywords String[]       // matched keywords
  
  // Media
  photos          String[]       // array of URLs/paths
  audioUrl        String?
  audioTranscript String?
  
  // Meta
  userId          String
  categoryId      String?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  kelurahan   Kelurahan?  @relation(fields: [kelurahanId], references: [id])
  categoryRef Category?   @relation(fields: [categoryId], references: [id])
  statusLogs  StatusLog[]

  @@map("reports")
}

model StatusLog {
  id          String       @id @default(uuid())
  reportId    String
  fromStatus  ReportStatus?
  toStatus    ReportStatus
  note        String?
  changedById String
  changedAt   DateTime     @default(now())

  report      Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  changedBy   User    @relation(fields: [changedById], references: [id])

  @@map("status_logs")
}
