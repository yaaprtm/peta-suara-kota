# Environment variables for backend
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL with PostGIS)
DATABASE_URL="postgresql://postgres:password@localhost:5432/peta_suara_kota?schema=public"

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-minimum-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Storage (local for development, replace with S3/Cloudinary for production)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Supabase (optional - for cloud file storage)
# SUPABASE_URL=your-supabase-url
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_BUCKET=reports
