APP_NAME="Peta Suara Kota Surabaya"
APP_ENV=production
APP_KEY=base64:YOUR_PRODUCTION_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://your-domain.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database: TiDB Cloud ─────────────────────────────────────────────────────
# TiDB Cloud adalah MySQL-compatible distributed database
# Port 4000 wajib, koneksi TLS otomatis diaktifkan di config/database.php
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=peta_suara_kota
DB_USERNAME=your_tidb_username
DB_PASSWORD=your_tidb_password
# Tidak perlu MYSQL_ATTR_SSL_CA — config/database.php mendeteksi port 4000 secara otomatis

# ─── Session & Cache ─────────────────────────────────────────────────────────
# WAJIB 'database' untuk serverless Vercel (file-based tidak persist)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.your-domain.vercel.app
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log

# ─── Filesystem (Upload) ─────────────────────────────────────────────────────
# WAJIB 's3' untuk Vercel serverless — local storage tidak persist
FILESYSTEM_DISK=s3

QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=psk_

# ─── S3-Compatible Storage ────────────────────────────────────────────────────
# Gunakan Cloudflare R2 (free tier) atau AWS S3
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=peta-suara-kota
AWS_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
AWS_URL=https://your-public-r2-domain.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Mapbox ───────────────────────────────────────────────────────────────────
VITE_APP_NAME="Peta Suara Kota"
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# ─── Mail (Opsional) ─────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@petasuarakota.id"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=your-domain.vercel.app
