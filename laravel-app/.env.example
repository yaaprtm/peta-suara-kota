APP_NAME=PATROL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=peta_suara_kota
DB_USERNAME=root
DB_PASSWORD=

# ─── TiDB Cloud (production / Vercel) ────────────────────────────────────────
# Ganti nilai di atas dengan ini untuk koneksi ke TiDB Cloud:
# DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_DATABASE=peta_suara_kota
# DB_USERNAME=37QUz3orFjoX5zX.root
# DB_PASSWORD=your_tidb_password
# (SSL/TLS aktif otomatis karena port 4000 — tidak perlu config tambahan)

# ===== IMPORTANT FOR PRODUCTION =====
# Session and Cache MUST use 'database' driver for serverless (Vercel/Lambda)
# File-based drivers will NOT persist across serverless function invocations
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# For production: use 's3' for uploads persistence
# For local development: use 'local' or 'public'
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Cache MUST use 'database' for serverless environments
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-Compatible Storage Configuration
# Required for production (Vercel) - recommended: Cloudflare R2 (free tier)
# Alternatives: AWS S3, DigitalOcean Spaces, Wasabi, Backblaze B2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
AWS_ENDPOINT=
# Public URL for accessing uploaded files
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
