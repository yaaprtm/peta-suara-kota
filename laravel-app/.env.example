APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=peta_suara_kota
DB_USERNAME=root
DB_PASSWORD=

# ─── TiDB Cloud (production / Vercel) ─────────────────────────────────────────
# Koneksi TiDB dipertahankan selama fase migrasi (Tahap 1-5).
# Akan dihapus setelah Tahap 6 (pembersihan jejak TiDB).
# DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_DATABASE=peta_suara_kota
# DB_USERNAME=your_tidb_username
# DB_PASSWORD=your_tidb_password

# ─── Session, Cache, Queue ─────────────────────────────────────────────────────
# Arsitektur Firebase: session=cookie, cache=file (atau array), queue=sync.
# File-based cache aman untuk serverless Vercel karena cache bersifat ephemeral
# (tidak perlu persist lintas invokasi — data persisten ada di Firestore).
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Foto dan audio disimpan di S3-compatible (bukan Firebase Storage)
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-Compatible Storage Configuration
# Required for production (Vercel) - recommended: Cloudflare R2 (free tier)
# Alternatives: AWS S3, DigitalOcean Spaces, Wasabi, Backblaze B2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
AWS_ENDPOINT=
# Public URL for accessing uploaded files
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Firebase / Firestore ──────────────────────────────────────────────────────
# Driver: 'firestore' untuk production, 'inmemory' untuk testing otomatis.
FIREBASE_DRIVER=firestore

# ID project Firebase (wajib)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ID database Firestore (default: "(default)")
FIREBASE_DATABASE_ID=(default)

# Kredensial Service Account — PILIH SALAH SATU:
#
# (A) Lokal / development: path absolut ke file JSON service account.
#     File ini TIDAK boleh di-commit ke git (sudah di .gitignore).
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/serviceAccountKey.json

# (B) Production / Vercel: isi base64 dari file JSON service account.
#     Cara encode: base64 -i serviceAccountKey.json (macOS/Linux)
#                  [Convert]::ToBase64String([IO.File]::ReadAllBytes('key.json')) (Windows)
FIREBASE_CREDENTIALS_BASE64=

# Emulator lokal (opsional, kosongkan di production)
# Format: host:port (contoh: localhost:8080)
FIREBASE_EMULATOR_HOST=
