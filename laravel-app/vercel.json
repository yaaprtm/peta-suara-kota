{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install --ignore-scripts",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/data/(.*)",
      "dest": "/public/data/$1"
    },
    {
      "src": "/storage/(.*)",
      "dest": "/public/storage/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/favicon.svg",
      "dest": "/public/favicon.svg"
    },
    {
      "src": "/robots.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/patrol-logo.png",
      "dest": "/public/patrol-logo.png"
    },
    {
      "src": "/(.*\\.png)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*\\.jpg)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*\\.jpeg)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*\\.gif)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*\\.webp)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*\\.svg)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*\\.woff2?)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "database",
    "CACHE_STORE": "database",
    "QUEUE_CONNECTION": "sync",
    "FILESYSTEM_DISK": "s3"
  }
}
