{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc && vite build",
        "vercel-build": "tsc && vite build",
        "dev": "vite",
        "lint": "eslint resources/js --ext .ts,.tsx --max-warnings 50",
        "lint:fix": "eslint resources/js --ext .ts,.tsx --fix",
        "format": "prettier --write resources/js/**/*.{ts,tsx}",
        "format:check": "prettier --check resources/js/**/*.{ts,tsx}",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^2.0.0",
        "@tailwindcss/forms": "^0.5.9",
        "@typescript-eslint/eslint-plugin": "^8.20.0",
        "@typescript-eslint/parser": "^8.20.0",
        "@types/mapbox-gl": "^3.4.1",
        "@types/node": "^22.10.0",
        "@types/react": "^18.3.5",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "autoprefixer": "^10.4.20",
        "concurrently": "^10.0.3",
        "esbuild": "^0.25.0",
        "eslint": "^9.18.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^5.1.0",
        "globals": "^15.14.0",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.4.47",
        "prettier": "^3.4.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwindcss": "^3.4.13",
        "terser": "^5.36.0",
        "typescript": "^5.6.2",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@tabler/icons-react": "^3.49.0",
        "@turf/boolean-point-in-polygon": "^7.4.0",
        "axios": "^1.20.0",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "mapbox-gl": "^3.33.0",
        "react-dropzone": "^20.1.4",
        "react-hot-toast": "^2.6.1",
        "zustand": "^5.0.16"
    }
}
